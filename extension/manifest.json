{
   "manifest_version" : 3,
   "name" : "Dark Pattern Analyzer",
   "version" : "1.0.0",
   "description" : "Detects potential dark patterns on websites.",

   "action" : {
      "default_popup": "popup/popup.html"
   },
   "content_scripts":[
      {
         "matches": ["<all_urls>"],
         "js" : ["content.js"]
      }
   ]
}