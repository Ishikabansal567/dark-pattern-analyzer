{
  "manifest_version": 3,

  "name": "Dark Pattern Analyzer",

  "version": "1.0.0",

  "description": "Detects potential dark patterns on websites.",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}